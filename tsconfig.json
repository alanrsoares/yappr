{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "~/*": [
        "./apps/cli/src/*",
        "./packages/sdk/src/*",
        "./packages/lib/src/*",
        "./packages/db/src/*"
      ],
      "@yappr/lib/*": ["./packages/lib/src/*"],
      "@yappr/sdk": ["./packages/sdk/src/index.ts"],
      "@yappr/sdk/*": ["./packages/sdk/src/*"],
      "@yappr/db": ["./packages/db/src/index.ts"],
      "@yappr/db/*": ["./packages/db/src/*"]
    }
  },
  "include": [
    "apps/cli/src/**/*",
    "packages/sdk/src/**/*",
    "packages/lib/src/**/*",
    "packages/db/src/**/*"
  ],
  "exclude": ["node_modules", "apps/desktop"]
}
