{
  "name": "@yappr/db",
  "version": "0.0.1",
  "description": "Yappr persistence \u2014 bun:sqlite + Drizzle. Shared by CLI and desktop. DB lives at ~/.yappr/yappr.db.",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "cd ../.. && drizzle-kit generate --config packages/db/drizzle.config.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts",
    "./rpc": "./src/rpc.ts"
  },
  "dependencies": {
    "@yappr/lib": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "neverthrow": "^8.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
