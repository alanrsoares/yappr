{
  "name": "@yappr/desktop",
  "version": "0.0.1",
  "description": "Yappr desktop companion (experimental) — voice loop + chat surface for the local-first Yappr stack",
  "private": true,
  "scripts": {
    "start": "vite build && electrobun dev",
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "vite --port 5173",
    "build:canary": "vite build && electrobun build --env=canary",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@styled-cva/react": "^0.7.1",
    "electrobun": "1.18.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
