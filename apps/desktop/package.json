{
  "name": "@yappr/desktop",
  "version": "0.0.1",
  "description": "Yappr desktop companion (experimental) — voice loop + chat surface for the local-first Yappr stack",
  "private": true,
  "scripts": {
    "start": "vite build && electrobun dev",
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "vite --port 5173",
    "build:canary": "vite build && electrobun build --env=canary",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@radix-ui/react-avatar": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-scroll-area": "^1.2.13",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.4.2",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@styled-cva/react": "^0.7.1",
    "@tanstack/ai": "^0.39.1",
    "@tanstack/ai-client": "^0.19.2",
    "@tanstack/ai-ollama": "^0.8.13",
    "@tanstack/ai-react": "^0.16.3",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-store": "^0.11.0",
    "@tanstack/store": "^0.11.0",
    "@yappr/db": "workspace:*",
    "@yappr/lib": "workspace:*",
    "@yappr/sdk": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "effect": "^3.21.4",
    "electrobun": "1.18.1",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-pattern": "^5.9.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
