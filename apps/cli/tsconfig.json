{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "@yappr/lib/*": ["../../packages/lib/src/*"],
      "@yappr/sdk": ["../../packages/sdk/src/index.ts"],
      "@yappr/sdk/*": ["../../packages/sdk/src/*"],
      "@yappr/db": ["../../packages/db/src/index.ts"],
      "@yappr/db/*": ["../../packages/db/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "build"]
}
