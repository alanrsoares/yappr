{
  "name": "@yappr/cli",
  "version": "0.0.1",
  "description": "Yappr terminal UI and CLI commands.",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "tui": "bun run src/app.tsx",
    "speak": "bun run src/index.ts speak",
    "chat": "bun run src/index.ts chat",
    "voices": "bun run src/index.ts voices",
    "dev": "bun --watch src/index.ts"
  },
  "dependencies": {
    "@tanstack/ai": "^0.33.0",
    "@tanstack/ai-ollama": "^0.8.6",
    "@yappr/db": "workspace:*",
    "@yappr/lib": "workspace:*",
    "@yappr/sdk": "workspace:*",
    "cli-highlight": "^2.1.11",
    "effect": "^3.21.4",
    "ink": "^7.0.3",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "18.0.3",
    "marked-terminal": "^7.3.0",
    "neverthrow": "^8.2.0",
    "ollama": "^0.6.3",
    "react": "^19.2.6",
    "string-width": "^8.2.1",
    "ts-pattern": "^5.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1"
  }
}
