{
  "openapi": "3.1.0",
  "info": {
    "title": "Yappr inference sidecar (TTS + STT)",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Get Health",
        "description": "Report which inference subsystems are ready, and which adapters are bound.",
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/voices": {
      "get": {
        "summary": "Get Voices",
        "description": "List the voice ids the active TTS engine accepts.\n\nShape: ``{\"voices\": [\"<id>\", \u2026]}``. Engine-specific \u2014 Kokoro returns\n``af_*`` / ``am_*`` ids; Dia returns its preset names.",
        "operationId": "get_voices_voices_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/synthesize": {
      "post": {
        "summary": "Synthesize",
        "description": "Synthesize speech from text using the active TTS engine.\n\n**Response:** ``audio/wav`` bytes (HTTP 200). Returns 503 when TTS isn't loaded.",
        "operationId": "synthesize_synthesize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SynthesizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/transcribe": {
      "post": {
        "summary": "Transcribe",
        "description": "Transcribe uploaded audio to text and language metadata.\n\n**Response:** JSON ``{text, language, probability}``. Returns 503 if STT is unavailable.",
        "operationId": "transcribe_transcribe_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_transcribe_transcribe_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_transcribe_transcribe_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Audio upload (e.g. WAV). Transcribed with the active STT engine (``faster-whisper small.en`` by default)."
          }
        },
        "type": "object",
        "required": ["file"],
        "title": "Body_transcribe_transcribe_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "tts": {
            "type": "string",
            "title": "Tts",
            "description": "TTS engine status: ``ready`` or ``unavailable``."
          },
          "stt": {
            "type": "string",
            "title": "Stt",
            "description": "STT engine status: ``ready`` or ``unavailable``."
          },
          "tts_backend": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tts Backend",
            "description": "Name of the loaded TTS adapter (e.g. ``kokoro``, ``dia``); ``null`` when unavailable."
          },
          "stt_backend": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stt Backend",
            "description": "Name of the loaded STT adapter (e.g. ``whisper``); ``null`` when unavailable."
          }
        },
        "type": "object",
        "required": ["tts", "stt"],
        "title": "HealthResponse",
        "description": "JSON body for ``GET /health``."
      },
      "SynthesizeRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "description": "Plain text to speak."
          },
          "voice": {
            "type": "string",
            "title": "Voice",
            "description": "Engine-specific voice id. Kokoro accepts ``af_*`` / ``am_*`` ids; Dia accepts its preset names (``default_voice`` today). See ``GET /voices``.",
            "default": "af_aoede"
          },
          "speed": {
            "type": "number",
            "title": "Speed",
            "description": "Speaking-rate multiplier (1.0 = engine default). Engines without a speed knob (e.g. Dia) ignore this field silently.",
            "default": 1.0
          }
        },
        "type": "object",
        "required": ["text"],
        "title": "SynthesizeRequest",
        "description": "JSON body for ``POST /synthesize``.\n\nProduces a WAV-encoded audio stream from the configured TTS engine. Voice\nid and sample rate are engine-specific \u2014 see ``GET /voices`` for the\nactive catalog. Default voice on Kokoro is ``af_aoede``."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": ["loc", "msg", "type"],
        "title": "ValidationError"
      }
    }
  }
}
