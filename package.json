{
  "name": "yappr",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@hono/node-server": "^1.19.10",
    "@types/node": "^22.10.0",
    "brace-expansion": "^1.1.13",
    "esbuild": "^0.25.12",
    "fast-uri": "^3.1.2",
    "flatted": "^3.4.0",
    "hono": "^4.12.18",
    "minimatch": "^3.1.3",
    "path-to-regexp": "^8.4.0",
    "picomatch": "^4.0.4",
    "qs": "^6.14.2"
  },
  "scripts": {
    "start:py": "uv --project python run python python/server.py",
    "openapi:export": "PYTHONPATH=python uv --project python run python python/export_openapi.py && bunx openapi-typescript openapi.json -o packages/sdk/src/schema.d.ts",
    "test:py": "cd python && uv run pytest tests/ -v",
    "lint": "bun run --filter='./**' lint",
    "typecheck": "bun run --filter='./**' typecheck",
    "test": "bun test",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "db:generate": "bun run --filter @yappr/db db:generate",
    "deadcode": "knip --no-exit-code",
    "deadcode:strict": "knip",
    "format": "prettier --write .",
    "prepare": "husky",
    "serve": "bun run start:py",
    "tui": "cd apps/cli && bun run tui",
    "speak": "cd apps/cli && bun run speak",
    "chat": "cd apps/cli && bun run chat",
    "voices": "cd apps/cli && bun run voices",
    "dev": "cd apps/cli && bun run dev",
    "desktop": "bun --filter @yappr/desktop dev:hmr"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^9.39.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^64.0.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "knip": "^6.14.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "pretty-quick": "^4.2.2",
    "typescript-eslint": "^8.59.3"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
