{
  "name": "yappr",
  "type": "module",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "overrides": {
    "@hono/node-server": "^1.19.10",
    "@tanstack/react-store": "0.11.0",
    "@tanstack/store": "0.11.0",
    "@types/node": "^22.10.0",
    "brace-expansion": "^1.1.13",
    "esbuild": "^0.25.12",
    "fast-uri": "^3.1.2",
    "flatted": "^3.4.0",
    "hono": "^4.12.18",
    "minimatch": "^3.1.3",
    "path-to-regexp": "^8.4.0",
    "picomatch": "^4.0.4",
    "qs": "^6.14.2"
  },
  "scripts": {
    "start:py": "uv --project python run python python/server.py",
    "start:py:kokoro": "YAPPR_TTS_BACKEND=kokoro uv --project python run python python/server.py",
    "smoke:tts-stt": "bun run scripts/smoke-tts-stt.ts",
    "stop:py": "curl -fsS -XPOST http://127.0.0.1:8000/shutdown || lsof -ti :8000 | xargs -r kill -9",
    "openapi:export": "PYTHONPATH=python uv --project python run python python/export_openapi.py && bunx openapi-typescript openapi.json -o packages/sdk/src/schema.d.ts",
    "test:py": "cd python && uv run pytest tests/ -v",
    "check:py": "cd python && uv run check",
    "lint": "biome lint .",
    "typecheck": "bun run --filter='./**' typecheck",
    "test": "bun test",
    "format:check": "biome format .",
    "check": "biome check . && bun run typecheck && bun run test",
    "db:generate": "bun run --filter @yappr/db db:generate",
    "deadcode": "knip --no-exit-code",
    "deadcode:strict": "knip",
    "format": "biome format --write .",
    "prepare": "husky",
    "serve": "bun run start:py",
    "serve:kokoro": "bun run start:py:kokoro",
    "tui": "cd apps/cli && bun run tui",
    "speak": "cd apps/cli && bun run speak",
    "chat": "cd apps/cli && bun run chat",
    "voices": "cd apps/cli && bun run voices",
    "dev": "cd apps/cli && bun run dev",
    "desktop": "bun --filter @yappr/desktop dev:hmr"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "knip": "^6.24.0",
    "lint-staged": "^17.0.8",
    "openapi-typescript": "^7.13.0",
    "pretty-quick": "^4.2.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
