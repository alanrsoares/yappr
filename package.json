{
  "name": "yappr",
  "type": "module",
  "scripts": {
    "start:py": "python/venv/bin/python python/server.py",
    "openapi:export": "PYTHONPATH=python python/venv/bin/python python/export_openapi.py && bunx openapi-typescript openapi.json -o src/sdk/schema.d.ts",
    "assess:kokoro-voices": "PYTHONPATH=python python/venv/bin/python python/scripts/assess_kokoro_voices.py",
    "lint": "eslint .",
    "test:py": "cd python && python -m pytest tests/ -v",
    "test": "bun test",
    "tui": "bun run src/cli/app.tsx",
    "serve": "bun run start:py",
    "speak": "bun run src/cli/index.ts speak",
    "chat": "bun run src/cli/index.ts chat",
    "voices": "bun run src/cli/index.ts voices",
    "dev": "bun --watch src/cli/index.ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jiti": "^2.7.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/ai": "^0.15.0",
    "@tanstack/ai-ollama": "^0.6.11",
    "@types/marked-terminal": "^6.1.1",
    "cli-highlight": "^2.1.11",
    "ink": "^7.0.2",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "18.0.3",
    "marked-terminal": "^7.3.0",
    "neverthrow": "^8.2.0",
    "ollama": "^0.6.3",
    "react": "^19.2.6",
    "zod": "^4.4.3"
  }
}
